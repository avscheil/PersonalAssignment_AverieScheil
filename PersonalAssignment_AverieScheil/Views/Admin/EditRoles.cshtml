@model PersonalAssignment_AverieScheil.Models.EditRolesViewModel

<h1>Edit Roles</h1>

<p>Editing roles for: @Model.UserName</p>

<form asp-controller="Admin" asp-action="EditRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <div asp-validation-summary="All" class=""></div>

    @foreach (var role in Model.AvailableRoles)
        {
            <div>
                <label>
                    <input type="checkbox" name="SelectedRoles" value="@role" checked="@Model.SelectedRoles.Contains(role)" />
                    @role
                </label>
            </div>
        }

        <button type="submit" class="btn btn-primary">Save Roles</button>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>